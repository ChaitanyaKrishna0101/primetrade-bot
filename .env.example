# ─────────────────────────────────────────────────────────────────────────────
# PrimeTrade Bot — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Binance Futures Testnet credentials
# Get these from: https://testnet.binancefuture.com → API Key tab
BINANCE_API_KEY=your_testnet_api_key_here
BINANCE_API_SECRET=your_testnet_api_secret_here

# Testnet base URL (do not change unless using mainnet)
BINANCE_BASE_URL=https://testnet.binancefuture.com

# Google Gemini API key (optional — enables AI pre-trade analysis)
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Log directory (default: logs/)
LOG_DIR=logs
